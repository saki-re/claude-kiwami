# .env.example を .env という名前で写して、= のうしろに自分のものを入れます。
# .env は .gitignore で外してあるので、GitHub には上がりません。

# 自分の Claude のサブスクで動かすときの鍵（`claude setup-token` で作れます）。
# 空なら、このパソコンでログインしている Claude Code をそのまま使います。
CLAUDE_CODE_OAUTH_TOKEN=
# 2つ目のアカウントを使い分けたいときだけ（空でよい）
CLAUDE_CODE_OAUTH_TOKEN_2=

# 待ち受ける番号（決まりは 8030）
KIWAMI_PORT=8030

# リマインダーの時刻に Discord へ知らせたいときの webhook（空なら知らせない）
KIWAMI_DISCORD_WEBHOOK=
# 声かけを ntfy で知らせたいときの topic（空なら知らせない）
KIWAMI_NTFY_TOPIC=

# 手帳の索引の置き場（空なら自動で決めます。日本語の入ったパスには置けないため）
KIWAMI_TECHO_DB=
